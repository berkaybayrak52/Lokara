# dependencies
node_modules/

# builds
dist/
.next/
out/
.turbo/
*.tsbuildinfo

# environment — never commit secrets
.env
.env.*
!.env.example

# Prisma's generated client. The schema that produced it is gone (Phase H); this rule
# stays until the working copy is deleted, so `git add -A` can never sweep the binaries in.
packages/db/generated/

# pdf demo output
packages/pdf/output/

# test / coverage
coverage/

# playwright
playwright-report/
test-results/

# os / editor
.DS_Store
.idea/
.vscode/
*.log

# Python (uv workspace)
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
bun.lockb

# scratch handoff between tools — overwritten each task, not history
LAST_OUTPUT.md

# Agent system: the shared config IS project history (it wires the gates in AGENTS.md).
# A bare `settings.json` rule in a global gitignore would otherwise swallow it.
!.claude/settings.json
.claude/settings.local.json
