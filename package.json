{
  "name": "lokara",
  "private": true,
  "packageManager": "bun@1.3.14",
  "//": "Explicit list, not globs: the other apps/ and packages/ directories are Python-only (uv) and have no package.json.",
  "workspaces": ["apps/web", "packages/ui"],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yaml,yml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yaml,yml,css}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.5",
    "prettier": "^3.6.2",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.36.0"
  },
  "trustedDependencies": ["esbuild", "sharp", "unrs-resolver"]
}
