# ── Deployment ────────────────────────────────────────────────────────────────
# Required, no default: local | ci | staging | production (docs/01 D9).
# In staging/production the API refuses to start at all if AUTH_DEV_TOKEN or
# DEMO_SEED_ENABLED is on, or if SUPABASE_JWT_SECRET is still the published
# placeholder below. A missing ENVIRONMENT is a startup failure, never a silent
# "local" -- the whole point is that an unsafe deployment cannot boot quietly.
#
# Export it in your shell (`export ENVIRONMENT=local`) rather than relying on
# this line once copied to .env: `.env` values survive `monkeypatch.delenv`, and
# apps/api/tests/test_environment_guard.py asserts a *missing* ENVIRONMENT
# raises. A .env line makes that test unfalsifiable locally. See docs/01 D9.
ENVIRONMENT="local"

# ── Database ──────────────────────────────────────────────────────────────────
# TODO(supabase): replace with the Supabase Cloud (EU/Frankfurt) connection strings
# once the project + signed DPA exist. Until then the local docker-compose
# Postgres below is the fallback (see docker-compose.yml).
#
# Supabase (Frankfurt) placeholders:
#   DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
#   DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"
# Local fallback: DATABASE_URL = runtime (lokara_app, non-superuser so RLS binds);
# DIRECT_URL = migrations (lokara, schema owner). Same split Supabase uses
# (pooler vs direct connection).
DATABASE_URL="postgresql://lokara_app:lokara@localhost:54322/lokara"
DIRECT_URL="postgresql://lokara:lokara@localhost:54322/lokara"

# ── Auth ──────────────────────────────────────────────────────────────────────
# Local/CI uses the deterministic HS256 development token. A deployed new
# Supabase project uses ES256 instead: set SUPABASE_JWT_ALGORITHM="ES256",
# unset SUPABASE_JWT_SECRET and set the issuer/JWKS URLs shown below.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY="<anon-key>"
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="<publishable-key>"
SUPABASE_JWT_ALGORITHM="HS256"
SUPABASE_JWT_SECRET="local-dev-secret-change-me-min-32-chars!!"
SUPABASE_JWT_ISSUER="http://127.0.0.1:54321/auth/v1"
# Production ES256 example:
# SUPABASE_JWT_ISSUER="https://<project-ref>.supabase.co/auth/v1"
# SUPABASE_JWKS_URL="https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json"

# Dev-only: enables POST /auth/dev-token on the API so the auth-guard path can be
# exercised without a Supabase project. MUST be "false" (or unset) in production.
AUTH_DEV_TOKEN="true"

# Dev/pitch-only: enables POST /demo/load (one-click "Demo-Szenario laden").
# MUST be "false" (or unset) in production.
DEMO_SEED_ENABLED="true"

# ── Apps ──────────────────────────────────────────────────────────────────────
API_PORT="3001"
WEB_ORIGIN="http://localhost:3000"
# Server-only destination used by the Next.js same-origin proxy and session
# handler. Never expose database credentials or service-role keys to Next.js.
API_BACKEND_URL="http://127.0.0.1:3001"
