{
  "name": "@lokara/api",
  "version": "0.0.1",
  "private": true,
  "description": "NestJS HTTP/JSON API — the one backend web and the launch-day native apps consume. Prisma lives here.",
  "main": "./dist/main.js",
  "exports": {
    ".": "./dist/main.js",
    "./contract": "./src/contract.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@lokara/adapters": "workspace:*",
    "@lokara/db": "workspace:*",
    "@lokara/domain": "workspace:*",
    "@nestjs/common": "^11.1.3",
    "@nestjs/core": "^11.1.3",
    "@nestjs/platform-express": "^11.1.3",
    "dotenv": "^17.0.1",
    "jsonwebtoken": "^9.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "tsx": "^4.20.3",
    "vitest": "^3.2.4"
  }
}
